add_cells_to_pblock [get_pblocks  {CLKAG_ref200_clk}] [get_cells -filter { PRIMITIVE_GROUP != I/O && IS_PRIMITIVE==1 && PRIMITIVE_LEVEL !=INTERNAL } -of_object [get_pins -filter {DIRECTION==IN} -of_objects [get_nets -hierarchical -filter {PARENT=="ref200_clk"}]]]
resize_pblock [get_pblocks {CLKAG_ref200_clk}] -add {CLOCKREGION_X1Y2:CLOCKREGION_X1Y2}
