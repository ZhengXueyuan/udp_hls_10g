CALL|T=/home/a/xdma_test/dma_ip_drivers-patched/XDMA/linux-kernel/tools\nD=/dev/xdma0_user\nrd(){ $T/reg_rw $D "$1" w 2>/dev/null | tail -1 | sed 's/.*: *//'; }\ng0=$(rd 0x1c); g0=$(( (g0 >> 16) & 0xffff ))\nt0=$(date +%s.%N)\n$T/reg_rw $D 0x18 w 0x1 >/dev/null 2>&1\nfor i in $(seq 1 100); do s=$(rd 0x1c); [ -n "$s" ] && [ $(( s & 2 )) -ne 0 ] && break; sleep 0.01; done\nt1=$(date +%s.%N)\ng1=$(rd 0x1c); g1=$(( (g1 >> 16) & 0xffff ))\nprintf 'SNAP_BEGIN\n'\nprintf 'TLATCH %s %s\n' "$t0" "$t1"\nprintf 'GEN %s %s\n' "$g0" "$g1"\nprintf 'MAGIC %s\n'  "$(rd 0x00)"\nprintf 'BID %s\n'    "$(rd 0x04)"\nprintf 'MARKER %s\n' "$(rd 0x14)"\nfor i in $(seq 0 50); do printf 'W%s %s\n' "$i" "$(rd $(printf '0x%X' $(( 0x20 + 4*i ))))"; done\nprintf 'UNIMPL %s\n' "$(rd 0xEC)"\nprintf 'SNAP_END\n'
