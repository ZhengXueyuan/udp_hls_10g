#!/bin/bash
# 假 reg_rw: $1=dev $2=addr [w [data]]; 输出形态与真 reg_rw 逐字一致
DEV="$1"; A=$(echo "$2" | tr '[:lower:]' '[:upper:]'); OP="${3:-}"; DAT="${4:-}"
NOW=$(cat "/d/repo/XCKU5PMini/udp_hls_10g/_proj_10g/notes/p7b_gate4_tools/fix2/vclk")          # 与假 date 同一时间基 (虚拟钟)
echo "$A" >> "${FAKE_ADDRLOG:-/dev/null}"
if [ "$OP" = "w" ] && [ -n "$DAT" ]; then
  if [ "$A" = "0X18" ]; then
    [ "${FAKE_GEN_STUCK:-0}" = "1" ] || echo $(( $(cat "/d/repo/XCKU5PMini/udp_hls_10g/_proj_10g/notes/p7b_gate4_tools/fix2/gen") + 1 )) > "/d/repo/XCKU5PMini/udp_hls_10g/_proj_10g/notes/p7b_gate4_tools/fix2/gen"
    [ "${FAKE_STALE:-0}" = "1" ] || echo "$NOW" > "/d/repo/XCKU5PMini/udp_hls_10g/_proj_10g/notes/p7b_gate4_tools/fix2/latch"
  fi
  echo "Write 32-bit $DAT to address $A"; exit 0
fi
LT=$(cat "/d/repo/XCKU5PMini/udp_hls_10g/_proj_10g/notes/p7b_gate4_tools/fix2/latch")
freecnt(){ awk -v t="$1" -v f="$2" 'BEGIN{ n=int((t-1700000000)*f)%4294967296; if(n<0) n+=4294967296; printf "0x%08x", n }'; }
case "$A" in
  0X00) V=0x50360001;;
  0X04) V=${FAKE_BID:-0x00000018};;   # 构建 D = 0x18 (⛔ 原 0x00000017 = 构建 C / 0x0000000A = Stage C);
                                       # 必须与被验的 p6e_snap_check.sh 默认 EXPECT_BID **同代**
                                       # (否则 case ① 正对照因判据 1.2 身份不符**假红**); 可覆盖。
  0X08) V=0x00000000;;
  0X0C) V=$(freecnt "$LT" 250000000);;
  0X10) V=0x00000018;;
  0X14) V=0xdeadbeef;;
  0X18) V=0x00000000;;
  0X1C) V=$(awk -v g="$(cat "/d/repo/XCKU5PMini/udp_hls_10g/_proj_10g/notes/p7b_gate4_tools/fix2/gen")" 'BEGIN{printf "0x%08x", g*65536+2}');;
  0X20) V=0x00000045;; 0X24) V=0x00002bb4;; 0X28) V=0x0000014d;; 0X30) V=0x00000000;;
  0X34) V=$(freecnt "$LT" 156250000);;                       # W5  前端域 (P7B = PCS 恢复钟 156.25)
  0X80) V=$(freecnt "$LT" 156250000);;                       # W24 数据面域 156.25
  0X3C) V=0x00000000;; 0X40) V=0x00000000;; 0X44) V=0x00000000;;
  0X9C) V=0x00000000;; 0XA0) V=0x00000000;; 0XA4) V=0x00000000;; 0XA8) V=0x00000000;;
  0XBC) V=0x2000100c;; 0XC0) V=0x000000ff;;
  0XE8) V=$(freecnt "$LT" 156250000);;                       # W50 toggle (÷1 口径 ⇒ 156.25)
  0X11C) V=0x00000000;;                                       # W63 app_pattern.stat_frmwait_cyc (65 字起)
  0X120) V=0x00000000;;                                       # W64 app_pattern.stat_bp_cyc
  0X124) V=0x00000000;;                                       # W65 mac_tx_10g.stat_tx_idle (66 字起; 构建 D)
  0X128) V=0xffffffff;;                                       # 未实现地址 (66 字; 0xEC -> 0x114 -> 0x11C -> 0x124 -> **0x128**)
  *)    V=0x00000000;;
esac
echo "Read 32-bit from address $A : $V"
